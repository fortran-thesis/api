rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isMycologist() {
      return isAuthenticated() && request.auth.token.role == 'mycologist';
    }

    function isCurator() {
      return isAuthenticated() && request.auth.token.role == 'curator';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Molds collection - public read
    match /molds/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      // Device tokens are stored as users/{userId}/device_tokens/{tokenId}
      match /device_tokens/{tokenId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Any other user-scoped subcollections
      match /{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Mold Reports - owner and admin can read/write, mycologist can read
    // Codebase collection name: mold_reports
    match /mold_reports/{reportId} {
      allow read: if isAuthenticated() &&
        (resource.data.user_id == request.auth.uid || isAdmin() || isMycologist());
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        (resource.data.user_id == request.auth.uid || isAdmin());

      // Case details subcollection: mold_reports/{reportId}/case_details/{detailId}
      match /case_details/{detailId} {
        allow read: if isAuthenticated() &&
          (
            get(/databases/$(database)/documents/mold_reports/$(reportId)).data.user_id == request.auth.uid ||
            isAdmin() ||
            isMycologist()
          );
        allow write: if isAdmin() || isMycologist();
      }
    }

    // Mold Cases - assigned mycologist and admin read/write
    // Codebase collection name: mold_cases
    match /mold_cases/{caseId} {
      allow read: if isAuthenticated() &&
        (resource.data.mycologist_id == request.auth.uid || isAdmin());
      allow create: if isAdmin() ||
        (isMycologist() && request.resource.data.mycologist_id == request.auth.uid);
      allow update, delete: if isAdmin() ||
        (isMycologist() && resource.data.mycologist_id == request.auth.uid);

      // Cultivation logs subcollection: mold_cases/{caseId}/cultivation_logs/{logId}
      match /cultivation_logs/{logId} {
        allow read: if isAuthenticated() &&
          (
            get(/databases/$(database)/documents/mold_cases/$(caseId)).data.mycologist_id == request.auth.uid ||
            isAdmin()
          );
        allow write: if isAdmin() ||
          (
            isMycologist() &&
            get(/databases/$(database)/documents/mold_cases/$(caseId)).data.mycologist_id == request.auth.uid
          );
      }
    }

    // Moldipedia - public read, curator/admin write
    match /moldipedia/{document=**} {
      allow read: if true;
      allow write: if isCurator() || isAdmin();
    }

    // Scanned molds - public read, server write
    // Codebase collection name: scanned_molds
    match /scanned_molds/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Monitored molds - authenticated read, server write
    // Codebase collection name: monitored_molds
    match /monitored_molds/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Flag reports - admin read, server write
    // Codebase collection name: flag_reports
    match /flag_reports/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Notifications - owner/admin read, server writes
    // Codebase stores notifications in top-level /notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        (resource.data.recipient_id == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Legacy path kept explicitly denied (current code does not use this path)
    match /device_tokens/{document=**} {
      allow read, write: if false;
    }

    // Audit logs - admin read only
    // Codebase collection name: audit_logs
    match /audit_logs/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // FAQ - public read, curator/admin write
    match /faq/{document=**} {
      allow read: if true;
      allow write: if isCurator() || isAdmin();
    }

    // Reports - authenticated create, admin read/update/delete
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // System requests - authenticated create, admin read/update/delete
    match /system_requests/{requestId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Investigations - explicit server-only until client policy is defined
    match /investigations/{document=**} {
      allow read, write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
