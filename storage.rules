rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Mold Reports - users can read their own, admins can read all
    match /mold-reports/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Server only
    }
    
    // Cultivation Logs - authenticated users can read
    match /cultivation-logs/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }
    
    // Moldipedia - public read, curator write
    match /moldipedia/{document=**} {
      allow read: if true; // Public
      allow write: if false; // Server only
    }
    
    // Scanned Molds - authenticated read only
    match /scanned-molds/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Server only
    }
    
    // Monitored Molds - authenticated users
    match /monitored-molds/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Server only
    }
    
    // User avatars/profiles
    match /users/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Server only
    }
    
    // Temp files - cleanup periodically
    match /temp/{allPaths=**} {
      allow read, write: if false;
    }
    
    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}