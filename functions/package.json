{
  "name": "functions",
  "scripts": {
    "before-push": "tsc --noEmit && eslint --ext .js,.ts . && jest && npm run test:integration:emulator",
    "lint": "eslint --ext .js,.ts .",
    "type-check": "tsc --noEmit",
    "build": "tsc && xcopy /E /I /Y src\\configs\\*.json lib\\configs\\",
    "build:linux": "tsc && cp src/configs/firebase-config.json lib/configs/",
    "local-dev": "ts-node-dev --respawn --transpile-only --poll src/local.ts",
    "emulator-dev": "npm run build && firebase emulators:start",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "test": "jest",
    "test:unit": "jest --testPathPatterns=tests/unit",
    "test:integration": "dotenv -e .env.test -- jest --config jest.integration.config.js --runInBand",
    "test:integration:emulator": "firebase emulators:exec --only auth,firestore,storage --project thesis-dev-project \"npm run test:integration\"",
    "test-dev": "npm run local-dev && jest",
    "loadtest:model": "k6 run loadtests/model-predict.k6.js",
    "loadtest:lookup": "k6 run loadtests/lookup-report.k6.js",
    "loadtest:mold-report": "k6 run loadtests/mold-report.k6.js",
    "loadtest:mold-case": "k6 run loadtests/mold-case.k6.js",
    "loadtest:all": "k6 run loadtests/model-predict.k6.js && k6 run loadtests/lookup-report.k6.js && k6 run loadtests/mold-report.k6.js && k6 run loadtests/mold-case.k6.js",
    "loadtest:jmeter:mobile": "jmeter -n -t loadtests/jmeter/mobile-api.jmx -l loadtests/jmeter/results/mobile.jtl",
    "loadtest:jmeter:mobile:capacity": "dotenv -e loadtests/jmeter/profiles/mobile-capacity.env -- jmeter -n -t loadtests/jmeter/mobile-api.jmx -l loadtests/jmeter/results/mobile-capacity.jtl",
    "loadtest:jmeter:mobile:ratelimit": "dotenv -e loadtests/jmeter/profiles/mobile-ratelimit.env -- jmeter -n -t loadtests/jmeter/mobile-api.jmx -l loadtests/jmeter/results/mobile-ratelimit.jtl",
    "loadtest:jmeter:mobile:farmers": "npm run loadtest:jmeter:mobile:farmers:performance",
    "loadtest:jmeter:mobile:farmers:performance": "dotenv -e loadtests/jmeter/profiles/mobile-capacity.env -- jmeter -n -t loadtests/jmeter/mobile-farmers-readonly.jmx -l loadtests/jmeter/results/mobile-farmers.jtl -Jmobile_farmer_sessions_csv=loadtests/jmeter/data/mobile-farmer-sessions.csv",
    "loadtest:jmeter:mobile:farmers:load": "dotenv -e loadtests/jmeter/profiles/mobile-capacity.env -- jmeter -n -t loadtests/jmeter/mobile-farmers-readonly.jmx -l loadtests/jmeter/results/mobile-farmers-load.jtl -Jmobile_farmer_sessions_csv=loadtests/jmeter/data/mobile-farmer-sessions.csv -Jfarmer_users=40 -Jfarmer_ramp=90 -Jfarmer_duration=600 -Jfarmer_response_ms=3000",
    "loadtest:jmeter:mobile:farmers:throughput": "dotenv -e loadtests/jmeter/profiles/mobile-capacity.env -- jmeter -n -t loadtests/jmeter/mobile-farmers-readonly.jmx -l loadtests/jmeter/results/mobile-farmers-throughput.jtl -Jmobile_farmer_sessions_csv=loadtests/jmeter/data/mobile-farmer-sessions.csv -Jfarmer_users=30 -Jfarmer_ramp=75 -Jfarmer_duration=600 -Jfarmer_response_ms=3000",
    "loadtest:jmeter:mobile:farmers:stress": "dotenv -e loadtests/jmeter/profiles/mobile-capacity.env -- jmeter -n -t loadtests/jmeter/mobile-farmers-readonly.jmx -l loadtests/jmeter/results/mobile-farmers-stress.jtl -Jmobile_farmer_sessions_csv=loadtests/jmeter/data/mobile-farmer-sessions.csv -Jfarmer_users=70 -Jfarmer_ramp=150 -Jfarmer_duration=900 -Jfarmer_response_ms=5000",
    "loadtest:jmeter:mobile:farmers:stateful": "dotenv -e loadtests/jmeter/profiles/mobile-capacity.env -- jmeter -n -t loadtests/jmeter/mobile-api.jmx -l loadtests/jmeter/results/mobile-farmers-stateful.jtl -Jmobile_users_csv=loadtests/jmeter/data/mobile-farmers.csv -Jinclude_stateful_ops=true",
    "loadtest:jmeter:mobile:mycologists": "dotenv -e loadtests/jmeter/profiles/mobile-capacity.env -- jmeter -n -t loadtests/jmeter/mobile-api.jmx -l loadtests/jmeter/results/mobile-mycologists.jtl -Jmobile_users_csv=loadtests/jmeter/data/mobile-mycologists.csv -Jinclude_stateful_ops=true",
    "loadtest:jmeter:mobile:myco": "npm run loadtest:jmeter:mobile:myco:performance",
    "loadtest:jmeter:mobile:myco:performance": "jmeter -n -t loadtests/jmeter/mobile-myco-readonly.jmx -l loadtests/jmeter/results/mobile-myco.jtl -Jmobile_myco_sessions_csv=loadtests/jmeter/data/mobile-mycologist-sessions.csv -Jmobile_users=15 -Jmobile_ramp=45 -Jmobile_duration=300 -Jmobile_response_ms=2000",
    "loadtest:jmeter:mobile:myco:load": "jmeter -n -t loadtests/jmeter/mobile-myco-readonly.jmx -l loadtests/jmeter/results/mobile-myco-load.jtl -Jmobile_myco_sessions_csv=loadtests/jmeter/data/mobile-mycologist-sessions.csv -Jmobile_users=20 -Jmobile_ramp=75 -Jmobile_duration=600 -Jmobile_response_ms=3000",
    "loadtest:jmeter:mobile:myco:throughput": "jmeter -n -t loadtests/jmeter/mobile-myco-readonly.jmx -l loadtests/jmeter/results/mobile-myco-throughput.jtl -Jmobile_myco_sessions_csv=loadtests/jmeter/data/mobile-mycologist-sessions.csv -Jmobile_users=18 -Jmobile_ramp=60 -Jmobile_duration=600 -Jmobile_response_ms=3000",
    "loadtest:jmeter:mobile:myco:stress": "jmeter -n -t loadtests/jmeter/mobile-myco-readonly.jmx -l loadtests/jmeter/results/mobile-myco-stress.jtl -Jmobile_myco_sessions_csv=loadtests/jmeter/data/mobile-mycologist-sessions.csv -Jmobile_users=25 -Jmobile_ramp=120 -Jmobile_duration=900 -Jmobile_response_ms=5000",
    "loadtest:jmeter:web": "jmeter -n -t loadtests/jmeter/web-api.jmx -l loadtests/jmeter/results/web.jtl",
    "loadtest:jmeter:web:myco": "npm run loadtest:jmeter:web:myco:performance",
    "loadtest:jmeter:web:myco:performance": "jmeter -n -t loadtests/jmeter/web-myco-readonly.jmx -l loadtests/jmeter/results/web-myco.jtl -Jweb_admin_sessions_csv=loadtests/jmeter/data/web-admin-sessions.csv -Jweb_users=15 -Jweb_ramp=45 -Jweb_duration=300 -Jweb_response_ms=2000",
    "loadtest:jmeter:web:myco:load": "jmeter -n -t loadtests/jmeter/web-myco-readonly.jmx -l loadtests/jmeter/results/web-myco-load.jtl -Jweb_admin_sessions_csv=loadtests/jmeter/data/web-admin-sessions.csv -Jweb_users=20 -Jweb_ramp=75 -Jweb_duration=600 -Jweb_response_ms=3000",
    "loadtest:jmeter:web:myco:throughput": "jmeter -n -t loadtests/jmeter/web-myco-readonly.jmx -l loadtests/jmeter/results/web-myco-throughput.jtl -Jweb_admin_sessions_csv=loadtests/jmeter/data/web-admin-sessions.csv -Jweb_users=18 -Jweb_ramp=60 -Jweb_duration=600 -Jweb_response_ms=3000",
    "loadtest:jmeter:web:myco:stress": "jmeter -n -t loadtests/jmeter/web-myco-readonly.jmx -l loadtests/jmeter/results/web-myco-stress.jtl -Jweb_admin_sessions_csv=loadtests/jmeter/data/web-admin-sessions.csv -Jweb_users=25 -Jweb_ramp=120 -Jweb_duration=900 -Jweb_response_ms=5000",
    "loadtest:jmeter:web:admin": "npm run loadtest:jmeter:web:admin:performance",
    "loadtest:jmeter:web:admin:performance": "jmeter -n -t loadtests/jmeter/web-admin-readonly.jmx -l loadtests/jmeter/results/web-admin.jtl -Jweb_admin_sessions_csv=loadtests/jmeter/data/web-admin-sessions.csv -Jweb_users=15 -Jweb_ramp=45 -Jweb_duration=300 -Jweb_response_ms=2000",
    "loadtest:jmeter:web:admin:load": "jmeter -n -t loadtests/jmeter/web-admin-readonly.jmx -l loadtests/jmeter/results/web-admin-load.jtl -Jweb_admin_sessions_csv=loadtests/jmeter/data/web-admin-sessions.csv -Jweb_users=20 -Jweb_ramp=75 -Jweb_duration=600 -Jweb_response_ms=3000",
    "loadtest:jmeter:web:admin:throughput": "jmeter -n -t loadtests/jmeter/web-admin-readonly.jmx -l loadtests/jmeter/results/web-admin-throughput.jtl -Jweb_admin_sessions_csv=loadtests/jmeter/data/web-admin-sessions.csv -Jweb_users=18 -Jweb_ramp=60 -Jweb_duration=600 -Jweb_response_ms=3000",
    "loadtest:jmeter:web:admin:stress": "jmeter -n -t loadtests/jmeter/web-admin-readonly.jmx -l loadtests/jmeter/results/web-admin-stress.jtl -Jweb_admin_sessions_csv=loadtests/jmeter/data/web-admin-sessions.csv -Jweb_users=25 -Jweb_ramp=120 -Jweb_duration=900 -Jweb_response_ms=5000",
    "loadtest:jmeter:e2e": "jmeter -n -t loadtests/jmeter/e2e-lifecycle.jmx -l loadtests/jmeter/results/e2e-lifecycle.jtl",
    "loadtest:jmeter:e2e:reject": "jmeter -n -t loadtests/jmeter/e2e-lifecycle.jmx -l loadtests/jmeter/results/e2e-lifecycle-reject.jtl -Je2e_admin_action=reject",
    "loadtest:jmeter:e2e:analysis": "jmeter -n -t loadtests/jmeter/e2e-lifecycle.jmx -l loadtests/jmeter/results/e2e-lifecycle-analysis.jtl -Je2e_include_analysis=true -Je2e_analysis_image_path=loadtests/jmeter/data/sample-cultivation.png",
    "loadtest:jmeter:community": "npm run loadtest:jmeter:community:performance",
    "loadtest:jmeter:community:performance": "jmeter -n -t loadtests/jmeter/community-api.jmx -l loadtests/jmeter/results/community-performance.jtl",
    "loadtest:jmeter:community:load": "jmeter -n -t loadtests/jmeter/community-api.jmx -l loadtests/jmeter/results/community-load.jtl -Jcommunity_users=40 -Jcommunity_ramp=90 -Jcommunity_duration=600 -Jcommunity_response_ms=3000",
    "loadtest:jmeter:community:throughput": "jmeter -n -t loadtests/jmeter/community-api.jmx -l loadtests/jmeter/results/community-throughput.jtl -Jcommunity_users=30 -Jcommunity_ramp=75 -Jcommunity_duration=600 -Jcommunity_response_ms=3000",
    "loadtest:jmeter:community:stress": "jmeter -n -t loadtests/jmeter/community-api.jmx -l loadtests/jmeter/results/community-stress.jtl -Jcommunity_users=70 -Jcommunity_ramp=150 -Jcommunity_duration=900 -Jcommunity_response_ms=5000",
    "loadtest:jmeter:report:community": "npm run loadtest:jmeter:report:community:performance",
    "loadtest:jmeter:report:community:performance": "jmeter -g loadtests/jmeter/results/community-performance.jtl -o loadtests/jmeter/results/community-performance-report",
    "loadtest:jmeter:report:community:load": "jmeter -g loadtests/jmeter/results/community-load.jtl -o loadtests/jmeter/results/community-load-report",
    "loadtest:jmeter:report:community:throughput": "jmeter -g loadtests/jmeter/results/community-throughput.jtl -o loadtests/jmeter/results/community-throughput-report",
    "loadtest:jmeter:report:community:stress": "jmeter -g loadtests/jmeter/results/community-stress.jtl -o loadtests/jmeter/results/community-stress-report",
    "loadtest:jmeter:all": "npm run loadtest:jmeter:mobile && npm run loadtest:jmeter:web",
    "loadtest:jmeter:report:mobile": "jmeter -g loadtests/jmeter/results/mobile.jtl -o loadtests/jmeter/results/mobile-report",
    "loadtest:jmeter:report:mobile:capacity": "jmeter -g loadtests/jmeter/results/mobile-capacity.jtl -o loadtests/jmeter/results/mobile-capacity-report",
    "loadtest:jmeter:report:mobile:ratelimit": "jmeter -g loadtests/jmeter/results/mobile-ratelimit.jtl -o loadtests/jmeter/results/mobile-ratelimit-report",
    "loadtest:jmeter:report:mobile:farmers": "npm run loadtest:jmeter:report:mobile:farmers:performance",
    "loadtest:jmeter:report:mobile:farmers:performance": "jmeter -g loadtests/jmeter/results/mobile-farmers.jtl -o loadtests/jmeter/results/mobile-farmers-report",
    "loadtest:jmeter:report:mobile:farmers:load": "jmeter -g loadtests/jmeter/results/mobile-farmers-load.jtl -o loadtests/jmeter/results/mobile-farmers-load-report",
    "loadtest:jmeter:report:mobile:farmers:throughput": "jmeter -g loadtests/jmeter/results/mobile-farmers-throughput.jtl -o loadtests/jmeter/results/mobile-farmers-throughput-report",
    "loadtest:jmeter:report:mobile:farmers:stress": "jmeter -g loadtests/jmeter/results/mobile-farmers-stress.jtl -o loadtests/jmeter/results/mobile-farmers-stress-report",
    "loadtest:jmeter:report:mobile:mycologists": "jmeter -g loadtests/jmeter/results/mobile-mycologists.jtl -o loadtests/jmeter/results/mobile-mycologists-report",
    "loadtest:jmeter:report:mobile:myco": "npm run loadtest:jmeter:report:mobile:myco:performance",
    "loadtest:jmeter:report:mobile:myco:performance": "jmeter -g loadtests/jmeter/results/mobile-myco.jtl -o loadtests/jmeter/results/mobile-myco-report",
    "loadtest:jmeter:report:mobile:myco:load": "jmeter -g loadtests/jmeter/results/mobile-myco-load.jtl -o loadtests/jmeter/results/mobile-myco-load-report",
    "loadtest:jmeter:report:mobile:myco:throughput": "jmeter -g loadtests/jmeter/results/mobile-myco-throughput.jtl -o loadtests/jmeter/results/mobile-myco-throughput-report",
    "loadtest:jmeter:report:mobile:myco:stress": "jmeter -g loadtests/jmeter/results/mobile-myco-stress.jtl -o loadtests/jmeter/results/mobile-myco-stress-report",
    "loadtest:jmeter:report:web": "jmeter -g loadtests/jmeter/results/web.jtl -o loadtests/jmeter/results/web-report",
    "loadtest:jmeter:report:web:myco": "npm run loadtest:jmeter:report:web:myco:performance",
    "loadtest:jmeter:report:web:myco:performance": "jmeter -g loadtests/jmeter/results/web-myco.jtl -o loadtests/jmeter/results/web-myco-report",
    "loadtest:jmeter:report:web:myco:load": "jmeter -g loadtests/jmeter/results/web-myco-load.jtl -o loadtests/jmeter/results/web-myco-load-report",
    "loadtest:jmeter:report:web:myco:throughput": "jmeter -g loadtests/jmeter/results/web-myco-throughput.jtl -o loadtests/jmeter/results/web-myco-throughput-report",
    "loadtest:jmeter:report:web:myco:stress": "jmeter -g loadtests/jmeter/results/web-myco-stress.jtl -o loadtests/jmeter/results/web-myco-stress-report",
    "loadtest:jmeter:report:web:admin": "npm run loadtest:jmeter:report:web:admin:performance",
    "loadtest:jmeter:report:web:admin:performance": "jmeter -g loadtests/jmeter/results/web-admin.jtl -o loadtests/jmeter/results/web-admin-report",
    "loadtest:jmeter:report:web:admin:load": "jmeter -g loadtests/jmeter/results/web-admin-load.jtl -o loadtests/jmeter/results/web-admin-load-report",
    "loadtest:jmeter:report:web:admin:throughput": "jmeter -g loadtests/jmeter/results/web-admin-throughput.jtl -o loadtests/jmeter/results/web-admin-throughput-report",
    "loadtest:jmeter:report:web:admin:stress": "jmeter -g loadtests/jmeter/results/web-admin-stress.jtl -o loadtests/jmeter/results/web-admin-stress-report",
    "k6": "npm run loadtest:all",
    "seed": "ts-node-dev --transpile-only --poll src/scripts/seed.ts",
    "seed:build": "npm run build && node lib/scripts/seed.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.48.3",
    "@google/generative-ai": "^0.24.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.4.0",
    "helmet": "^8.1.0",
    "lru-cache": "^11.2.6",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.9",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.6.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3",
    "ts-node-dev": "^2.0.0",
    "uuid": "^11.1.0",
    "validator": "^13.15.22",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.10",
    "@types/nodemailer": "^7.0.2",
    "@types/redis": "^4.0.10",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.2",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "jest": "^30.1.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "typescript": "^5.7.3"
  },
  "private": true
}
